# 环境变量配置文件（开发环境示例）
# 复制为 .env 后填入实际值，请勿将 .env 提交到版本控制

# JWT 签名密钥（生产环境请使用随机长字符串）
JWT_SECRET=your_super_secret_key_change_in_production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 服务器端口
PORT=3001

# 数据库文件路径
DB_PATH=./data/blog.db

# 管理员注册码（可选，用于保护 admin 注册）
ADMIN_SECRET=admin_register_secret_2024

# Node 环境
NODE_ENV=development

# ── AI 服务配置（OpenAI 兼容 API） ──
# 支持任何 OpenAI 兼容的 API 端点（如 DeepSeek、Moonshot、通义千问等）
# 不配置 API Key 时，博客其他功能不受影响，仅 AI 功能不可用
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-3.5-turbo
AI_IMAGE_MODEL=dall-e-3
