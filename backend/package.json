{
  "name": "blog-backend",
  "version": "1.0.0",
  "description": "个人博客系统后端 - Node.js + Express + SQLite",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --experimental-vm-modules node_modules/vitest/dist/cli.js run",
    "test:watch": "node --experimental-vm-modules node_modules/vitest/dist/cli.js",
    "test:coverage": "node --experimental-vm-modules node_modules/vitest/dist/cli.js run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dompurify": "^3.0.8",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^11.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "sql.js": "^1.14.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.2.2",
    "supertest": "^6.3.4",
    "vitest": "^1.2.2"
  }
}
